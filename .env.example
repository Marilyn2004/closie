EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
IMPORT_TOKEN=
DB_URL=jdbc:postgresql://127.0.0.1:55432/fashion_search
DB_USERNAME=fashion
DB_PASSWORD=fashion

# Backend-only optional user-query AI; default rules mode
CLOSIE_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
# Enable only after account/provider display review; stale eBay listings stay hidden
EBAY_DISPLAY_ENABLED=false
CLOSIE_PERMITTED_SOURCES=

# Local launcher loads .env.local; do not commit that file
CLOSIE_DEMO_ENABLED=false
CLOSIE_REFRESH_ENABLED=false
CLOSIE_REFRESH_INTERVAL_MS=14400000
EBAY_ENRICH_DETAILS=false
EBAY_DETAILS_PER_PAGE=5
EBAY_REQUEST_INTERVAL_MS=200
