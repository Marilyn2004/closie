EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
IMPORT_TOKEN=
DB_URL=jdbc:postgresql://127.0.0.1:55432/fashion_search
DB_USERNAME=fashion
DB_PASSWORD=fashion

# Backend-only optional user-query AI; default rules mode
CLOSIE_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
# Enable only after account/provider display review; stale eBay listings stay hidden
EBAY_DISPLAY_ENABLED=false
CLOSIE_PERMITTED_SOURCES=

# Local launcher loads .env.local; do not commit that file
CLOSIE_DEMO_ENABLED=false
CLOSIE_REFRESH_ENABLED=false
CLOSIE_REFRESH_INTERVAL_MS=14400000
EBAY_ENRICH_DETAILS=false
EBAY_DETAILS_PER_PAGE=5
EBAY_REQUEST_INTERVAL_MS=200

# Keep disabled until a stable public HTTPS callback has been reviewed and configured.
# Seller tracking scopes deletion; missing identity falls back to purge/pause (docs/EBAY_SETUP.md).
EBAY_NOTIFICATIONS_ENABLED=false
EBAY_NOTIFICATION_ENDPOINT=
EBAY_NOTIFICATION_VERIFICATION_TOKEN=

# Production ingestion requires seller ownership tracking with a stable private hex key.
EBAY_ACCOUNT_TRACKING_ENABLED=false
EBAY_ACCOUNT_HASH_KEY=
EBAY_SEARCH_KEYWORDS=leather jacket,cardigan,dress,sneakers,trousers,blouse,necklace,earrings,shoulder bag,tote bag

# Local concept studio only. No live paid calls until explicitly enabled.
# Image model names must be verified against the account's available models.
CLOSIE_GENERATION_ENABLED=false
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
CLOSIE_GENERATION_DAILY_LIMIT=12
# Existing OpenAI structured interpretation requires CLOSIE_AI_ENABLED/key/model AND this opt-in limit.
CLOSIE_TEXT_DAILY_LIMIT=0
CLOSIE_ASSET_PATH=.local/studio-assets
# Optional private-photo analysis; requires user consent per photo and a positive text daily limit.
CLOSIE_VISION_ENABLED=false
GEMINI_VISION_MODEL=

# OpenAI Images: use the existing API project's backend environment key above.
CLOSIE_IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare-2026-09-08
# Normal app allocation: lifetime $3, reserving $0.25 per paid request (max 12).
# For the one-request verification launch, explicitly set this to 1.
CLOSIE_OPENAI_MAX_PAID_REQUESTS=12
